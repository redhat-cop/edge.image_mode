# copied from https://github.com/sclorg/testing-farm-as-github-action/tree/main/plans
summary: Basic smoke test
execute:
  how: tmt
  script: |
    set +x
    echo I am $(id)
    echo I am placed at $(pwd)
    echo List Everything $(ls)
    echo -e "[ansible-developer-1.2-for-rhel-9-x86_64-rpms]\nname = Red Hat Ansible Developer 1.2 for RHEL 9 x86_64 (RPMs)\nbaseurl = ${RHTF_INTERNAL_REPO}/layered/rhel9/x86_64/ansible-developer/1.2/os\ngpgkey = file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release\nenabled = 1" > /etc/yum.repos.d/ansible-developer.repo
    dnf repolist
    dnf install -y molecule
